  keywords = {Endocrine reproductive disorders,Infertility,non-modeling-paper,Transcriptomics},
  file = {/Users/skjannetty/Zotero/storage/E8DZZB7E/Liu et al. - 2025 - Decrypting spatiotemporal code of human endometrial receptivity.pdf}
}

@article{miller_2025_mathematicalmodellingmacrophage,
  title = {Mathematical Modelling of Macrophage and Natural Killer Cell Immune Response during Early Stages of Peritoneal Endometriosis Lesion Onset},
