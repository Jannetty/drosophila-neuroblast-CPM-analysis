  keywords = {Animals,Cell Cycle,Cell Differentiation,Cell Lineage,DNA-Binding Proteins,Drosophila melanogaster,Drosophila Proteins,Flow Cytometry,Gene Expression Profiling,Gene Expression Regulation,Neural Stem Cells,Transcription Factors,Transcriptome},
  file = {/Users/skjannetty/Zotero/storage/I6D39TA9/Berger et al. - 2012 - FACS purification and transcriptome analysis of drosophila neural stem cells reveals a role for Klum.pdf}
}

