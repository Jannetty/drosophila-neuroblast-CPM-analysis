@article{tsankovaCellPolarityRegulates2017,
  title = {Cell {{Polarity Regulates Biased Myosin Activity}} and {{Dynamics}} during {{Asymmetric Cell Division}} via {{Drosophila Rho Kinase}} and {{Protein Kinase N}}},
  author = {Tsankova, Anna and Pham, Tri Thanh and Garcia, David Salvador and Otte, Fabian and Cabernard, Clemens},
  date = {2017-07},
  journaltitle = {Developmental Cell},
  shortjournal = {Developmental Cell},
  volume = {42},
  number = {2},
  pages = {143-155.e5},
  issn = {15345807},
  doi = {10.1016/j.devcel.2017.06.012},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1534580717305002},
  urldate = {2024-10-04},
  abstract = {Cell and tissue morphogenesis depends on the correct regulation of non-muscle Myosin II, but how this motor protein is spatiotemporally controlled is incompletely understood. Here, we show that in asymmetrically dividing Drosophila neural stem cells, cell intrinsic polarity cues provide spatial and temporal information to regulate biased Myosin activity. Using live cell imaging and a genetically encoded Myosin activity sensor, we found that Drosophila Rho kinase (Rok) enriches for activated Myosin on the neuroblast cortex prior to nuclear envelope breakdown (NEB). After NEB, the conserved polarity protein Partner of Inscuteable (Pins) sequentially enriches Rok and Protein Kinase N (Pkn) on the apical neuroblast cortex. Our data suggest that apical Rok first increases phospho-Myosin, followed by Pkn-mediated Myosin downregulation, possibly through Rok inhibition. We propose that polarityinduced spatiotemporal control of Rok and Pkn is important for unequal cortical expansion, ensuring correct cleavage furrow positioning and the establishment of physical asymmetry.},
  langid = {english},
  file = {/Users/skjannetty/Zotero/storage/V2G8TY44/Tsankova et al. - 2017 - Cell Polarity Regulates Biased Myosin Activity and.pdf}
}

@article{uv_1997_tissuespecificsplicingfunctions,
  title = {Tissue-Specific Splicing and Functions of the {{Drosophila}} Transcription Factor {{Grainyhead}}},
  author = {Uv, A. E. and Harrison, E. J. and Bray, S. J.},
  date = {1997-11},
