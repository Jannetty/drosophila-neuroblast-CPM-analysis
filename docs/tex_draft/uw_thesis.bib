@article{bowman_2006_drosophilanumahomologa,
  title = {The {{Drosophila NuMA Homolog Mud}} Regulates Spindle Orientation in Asymmetric Cell Division},
  author = {Bowman, Sarah K. and Neumüller, Ralph A. and Novatchkova, Maria and Du, Quansheng and Knoblich, Juergen A.},
  date = {2006-06},
  journaltitle = {Developmental Cell},
  shortjournal = {Dev Cell},
  volume = {10},
  number = {6},
  eprint = {16740476},
  eprinttype = {pubmed},
