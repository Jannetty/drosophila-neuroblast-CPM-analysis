@article{holy_1991_differentialbehaviorcentrosomes,
  title = {Differential Behavior of Centrosomes in Unequally Dividing Blastomeres during Fourth Cleavage of Sea Urchin Embryos},
  author = {Holy, Jon and Schatten, Gerald},
